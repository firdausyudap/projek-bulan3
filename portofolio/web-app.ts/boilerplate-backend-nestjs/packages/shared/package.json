{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate --schema src/prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma",
    "build": "swc src -d dist --strip-leading-paths",
    "format": "biome check --write",
    "lint": "biome check"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/client": "7.0.0",
    "nestjs-zod": "^5.0.1",
    "zod": "^4.1.12",
    "prisma": "7.0.0",
    "@prisma/adapter-pg": "7.0.0",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@repo/biome-config": "workspace:*",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.10.0",
    "typescript": "^5.9.3",
    "@types/pg": "^8.11.0"
  }
}
